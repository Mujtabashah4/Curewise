# CureWise AI backend — environment variables
# Copy to `.env` and fill in. Never commit the real `.env`.

# --- Auth / JWT ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:3000

# --- LLM / RAG providers ---
OPENAI_API_KEY=          # chat, embeddings, report structuring (gpt-4o-mini)
GROQ_API_KEY=            # per-disease chat + acne vision (llama-3.3-70b / llama-4-scout)
GOOGLE_API_KEY=          # optional
PINECONE_API_KEY=        # vector store for the RAG chatbot
LLAMA_PARSER_API_KEY=    # LlamaParse — blood-report PDF parsing

# --- PostgreSQL ---
DB_NAME=curewise
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- ML model weights (optional; default to repo-relative weights/ paths) ---
# Weights are large (~1.5 GB) and gitignored. Provision them into
# backend/weights/<key>/ or point these at wherever they live.
# KIDNEY_MODEL_PATH=
# BREAST_CANCER_MODEL_PATH=
# LYMPHOMA_MODEL_PATH=
# PNEUMONIA_MODEL_PATH=
# EYE_DISEASE_MODEL_PATH=
# BLOODCELL_MARKER_MODEL_PATH=
# BLOODCELL_TYPE_MODEL_PATH=
# FRACTURE_MODEL_PATH=
# BRAIN_LGG_MODEL_PATH=
# ARTERY_MODEL_PATH=
